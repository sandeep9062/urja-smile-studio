# =============================================================================
# Urja Dental Clinic - Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in your actual values.
# =============================================================================

# Database Connection - Neon PostgreSQL
# 1. Create a free account at https://neon.tech
# 2. Create a new project
# 3. Go to: Project → Connection Details → Connection string (format: URI)
# 4. Copy and paste below
# Example: postgresql://user:password@ep-cool-name-123456.ap-southeast-1.aws.neon.tech/urja-dental?sslmode=require
DATABASE_URL="postgresql://user:password@ep-example-region.aws.neon.tech/urja-dental?sslmode=require"

# NextAuth.js v5 (Auth.js)
AUTH_URL="http://localhost:3000"
AUTH_SECRET="urja-dental-nextauth-secret-change-in-production"

# Cloudinary — used by the media library + rich-text editor.
# 1. Create a free account at https://cloudinary.com
# 2. Find your Cloud Name, API Key and API Secret on the Dashboard.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# Optional: default folder for uploads (defaults to `urja-dental`).
# CLOUDINARY_FOLDER="urja-dental"

# -----------------------------------------------------------------------------
# Upstash Redis — rate limiting
# -----------------------------------------------------------------------------
# Used by `src/lib/rate-limit.ts` to enforce per-IP / per-user rate limits
# on API routes (login, contact form, booking form, admin actions, uploads).
#
# 1. Create a free account at https://upstash.com
# 2. Create a new Redis database (any region is fine).
# 3. On the database page, copy the REST credentials:
#      • "REST URL"  → UPSTASH_REDIS_REST_URL
#      • "REST Token" → UPSTASH_REDIS_REST_TOKEN
# Example:
#   UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
#   UPSTASH_REDIS_REST_TOKEN="AX...your-token..."
#
# If these are left blank, the rate limiter fails open (disabled) and the
# app continues to work normally — useful for local dev without internet.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
